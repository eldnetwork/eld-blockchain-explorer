VITE_RPC_URL=http://localhost:26657
VITE_API_URL=http://localhost:9001
VITE_ENABLE_VALIDATOR_ADMIN_STATUS=false
# Analytics page (/analytics). Browser base for health/usage paths (no /api prefix).
# Dev uses the Vite /analytics-api proxy; prod is the bare host (e.g. …/health).
# Dev: VITE_ANALYTICS_API_URL=/analytics-api
# Prod: VITE_ANALYTICS_API_URL=https://analytics.eld.network
VITE_ANALYTICS_API_URL=/analytics-api
# Proxy target for /analytics-api in vite.config.js (local only; no port in prod URL)
ANALYTICS_API_URL=http://127.0.0.1:9010
