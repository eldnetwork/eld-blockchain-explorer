{
  "name": "eld-blockchain-explorer",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Eld Blockchain Explorer — UI for the Eld decentralized ephemeral storage protocol",
  "homepage": "https://explorer.eld.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldnetwork/eld-blockchain-explorer.git"
  },
  "author": "Eld",
  "license": "MIT",
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "buffer": "^6.0.3",
    "framer-motion": "^10.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src eslint.config.mjs vite.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run format:check && npm run lint && npm test && npm audit --omit=dev --audit-level=high && npm run build"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "@chakra-ui/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@chakra-ui/system": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@emotion/react": {
      "react": "$react"
    },
    "@emotion/styled": {
      "react": "$react"
    },
    "framer-motion": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.12.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
