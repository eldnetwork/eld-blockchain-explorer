  "scripts": {
    "start": "react-scripts start",
    "build": "DISABLE_ESLint_PLUGIN=true react-scripts build",
    "preview": "npx --yes serve -s build",
    "lint": "eslint src eslint.config.mjs",
    "format": "prettier --write .",
